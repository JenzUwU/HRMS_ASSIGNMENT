# Public config (exposed to the browser)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=HRMS Post Offer Engagement

# The frontend holds no database credentials. The Supabase secret key lives only
# in the FastAPI backend (backend/.env). All data access goes through the API.

# Supabase Auth. Publishable/anon key ONLY - never the secret key. The browser
# uses this to sign users in against Supabase Auth; the backend verifies the
# resulting JWT with its own secret key (backend/.env).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
