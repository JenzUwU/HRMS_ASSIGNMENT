# docker compose reads ./.env automatically. Copy this to ./.env and fill in.
# These are the ONLY values compose needs directly - every backend server-side
# secret lives in backend/.env (also git-ignored).
#
# Everything here is browser-safe:
#   * NEXT_PUBLIC_SUPABASE_ANON_KEY is the publishable / anon key, NOT the
#     secret / service-role key. The secret key stays in backend/.env only.

# --- host ports (change only if 3000 / 8000 are already in use) ---
FRONTEND_PORT=3000
BACKEND_PORT=8000

# The browser origin the backend must allow (CORS). Match FRONTEND_PORT.
FRONTEND_ORIGIN=http://localhost:3000

# --- build-time NEXT_PUBLIC_* (inlined into the client bundle) ---
# What the browser calls to reach the API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=HRMS Post Offer Engagement

# Supabase Auth - project URL + publishable/anon key (safe for the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
