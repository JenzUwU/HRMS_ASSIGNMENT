# App
APP_NAME=HRMS Post Offer Engagement API
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# CORS (comma separated origins, no JSON)
BACKEND_CORS_ORIGINS=http://localhost:3000

# Supabase, new API key system (https://supabase.com/docs/guides/api/api-keys).
# SUPABASE_URL is the project URL, e.g. https://<ref>.supabase.co
# SUPABASE_SECRET_KEY (sb_secret_...) replaces the legacy service_role key.
#   It is server-side only. Never expose it to the browser or commit it.
# Without SUPABASE_URL and SUPABASE_SECRET_KEY, data endpoints return
#   HTTP 503 (database_not_configured).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Publishable key (sb_publishable_...) replaces the legacy anon key. The backend
# does not use it (the browser does, as NEXT_PUBLIC_SUPABASE_ANON_KEY). Optional.
SUPABASE_PUBLISHABLE_KEY=

# Groq (server-side only, used through app/services/groq_client.py).
# GROQ_API_KEY: never expose to the browser or commit. Without it the AI
#   endpoints return HTTP 503 (ai_not_configured).
# GROQ_MODEL: the free-tier key used in development has access to
#   openai/gpt-oss-20b (llama-3.3-* returns 404 for that key).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=1

# Resend (real transactional email, app/services/resend_client.py + email.py).
# RESEND_API_KEY: server-side only. Never expose to the browser, never commit,
#   never log. Without it the email endpoint returns HTTP 503 (email_not_configured).
# RESEND_FROM_EMAIL: a sender on a domain verified in your Resend account
#   (e.g. hr@yourdomain.com). Sending fails until the domain is verified.
# RESEND_WEBHOOK_SECRET: the Svix signing secret for the delivery-status webhook
#   (Resend dashboard → Webhooks → your endpoint → Signing Secret, "whsec_...").
#   When unset, POST /api/v1/webhooks/resend rejects every call (401).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=HR
RESEND_WEBHOOK_SECRET=
RESEND_TIMEOUT_SECONDS=30

# Gmail SMTP (real outbound candidate email, app/services/smtp_client.py +
# email.py). Server-side only. Never expose to the browser, never commit, never
# log. Without SMTP_HOST / SMTP_USERNAME / SMTP_PASSWORD the email endpoint
# returns HTTP 503 (email_not_configured).
# SMTP_PASSWORD: a Google App Password (Google Account -> Security -> 2-Step
#   Verification -> App passwords), NOT the Gmail account password. Set it only
#   in backend/.env (gitignored). Leave this file blank.
# EMAIL_FROM: usually the same address as SMTP_USERNAME (Gmail rejects a
#   mismatched From).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=HR
SMTP_TIMEOUT_SECONDS=30

# Inbound email via IMAP (app/services/imap_client.py + inbound_email.py).
# Reads candidate replies from the same Gmail mailbox used for outbound.
# IMAP_USERNAME / IMAP_PASSWORD default to the SMTP ones when left blank (the
# same Google App Password authenticates IMAP; IMAP must be enabled on the
# account). Server-side only; never logged.
# INBOUND_EMAIL_ENABLED gates BOTH the manual poll route and the automatic
#   background loop; while false the poll route returns 401, the loop does not
#   start, and nothing is ingested.
# INBOUND_POLL_TOKEN: shared secret required in the X-Inbound-Poll-Token header
#   on the manual poll route. The background loop does not use it (it calls the
#   service directly). Generate a random value if you use the manual route.
# INBOUND_EMAIL_POLL_INTERVAL_SECONDS: how often the background loop polls the
#   mailbox. Only runs when INBOUND_EMAIL_ENABLED=true AND IMAP is configured.
#   Assumes a single backend worker (see docker-compose.yml). Min 30s.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
IMAP_TIMEOUT_SECONDS=30
INBOUND_EMAIL_ENABLED=false
INBOUND_POLL_MAX=25
INBOUND_POLL_TOKEN=
INBOUND_EMAIL_POLL_INTERVAL_SECONDS=120

# WhatsApp (provider-agnostic, DISABLED by default - no provider connected).
# app/services/whatsapp.py. All values are server-side only, never logged, never
# sent to the browser. While WHATSAPP_ENABLED=false the send endpoint and the
# inbound webhook return HTTP 503 and nothing is sent or persisted.
# Connect a provider later: implement a WhatsAppProvider adapter (Meta Cloud API
# or Twilio), set WHATSAPP_PROVIDER + the credentials below, WHATSAPP_ENABLED=true.
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_TIMEOUT_SECONDS=30

# Automated engagement sweep (app/services/engagement_rules.py).
# AUTOMATION_ENABLED starts the in-process background loop. Leave false in
#   any multi-worker / production deployment and drive the sweep from an
#   external scheduler hitting POST /api/v1/automation/run-engagement-sweep.
AUTOMATION_ENABLED=false
AUTOMATION_INTERVAL_MINUTES=360
AUTOMATION_JOINING_WINDOW_DAYS=7
AUTOMATION_NO_INTERACTION_DAYS=5
AUTOMATION_DEDUP_DAYS=3
AUTOMATION_MAX_CANDIDATES_PER_RUN=25
